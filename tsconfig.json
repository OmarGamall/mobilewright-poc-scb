{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pages/*":       ["./pages/*"],
      "@components/*":  ["./pages/components/*"],
      "@fixtures":      ["./fixtures/index.ts"],
      "@fixtures/*":    ["./fixtures/*"],
      "@models/*":      ["./models/*"],
      "@helpers/*":     ["./helpers/*"],
      "@data/*":        ["./data/*"],
      "@utils/*":       ["./utils/*"]
    }
  },
  "include": ["**/*.ts"]
}
