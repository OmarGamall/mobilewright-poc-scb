# =============================================
# Machine-specific settings (never committed)
# =============================================
# Copy this file to .env (Windows: copy .env.example .env) and uncomment what you need.
# Every line is optional: an empty .env works when one device is connected and the
# app is already installed. CI sets these as job environment variables instead.
#
# Targets and bundle IDs are team-wide and live in config/targets.ts, not here.
# Pick the target per run: npm run test:android | test:android-emulator | test:ios-sim | test:ios
# =============================================

# Pin one device when several are connected (serial from `adb devices`, or simulator UDID).
# Unset = Mobilewright uses the first device matching the chosen target.
# DEVICE_ID=emulator-5554

# Build installed before the run. Unset = the app is already installed on the device.
# Must be an archive Mobilewright accepts as ZIP: .apk for Android, .ipa for iOS.
# ANDROID_APP=./builds/app-debug.apk
# IOS_APP=./builds/Runner.ipa
