# =============================================
# Machine-specific settings (never committed)
# =============================================
# Copy this file to .env (Windows: copy .env.example .env) and uncomment what you need.
# Every line is optional: an empty .env works when one device per target is connected
# and the app is already installed. CI sets these as job environment variables instead.
#
# Targets (projects) and the bundle ID are team-wide and live in mobilewright.config.ts.
# Pick the target per run: npm run test:android | test:android-emulator
# =============================================

# Pin one device. Only needed when 2+ devices of the same type are connected
# (the target's deviceType already tells a phone from an emulator), and by `npm run extract`.
# Serial from `adb devices`. Emulator IDs (emulator-5554, …) can change between boots.
# DEVICE_ID=emulator-5554

# Local .apk installed before the run. Unset = the app is already installed on the device.
# Must be a local file path, not a URL: on CI, download the build first, then point here.
# ANDROID_APP=./build/app.apk
